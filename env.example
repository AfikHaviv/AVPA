# Rename this file to ".env", fill in real values, then encrypt it:
#   uv run python -m cve_pipeline.crypto_env gen-key      # once, save the printed key somewhere safe
#   uv run python -m cve_pipeline.crypto_env encrypt .env .env.enc
# ".env" and the master key are gitignored. Only ".env.enc" is committed.

# Hugging Face token with Inference API access (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxx

# Open-source model served via the HF Inference API (no fine-tuning)
HF_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct

# Optional: raises NVD API rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Flask session secret
FLASK_SECRET_KEY=change-me

# Metasploit RPC (msfrpcd) - only needed for the live EternalBlue runner
# Start it in your lab with: msfrpcd -P <password> -S -a 127.0.0.1 -p 55553
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_PASSWORD=change-me
MSF_RPC_SSL=true
